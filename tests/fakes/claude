#!/usr/bin/env node
// A stand-in for the claude CLI used by scripts/selftest-ci.mjs. FAKE_CLAUDE_MODE: ok | error | nostructure | invalid | text. FAKE_CLAUDE_REPORT: path of the report to return.
import fs from 'node:fs';
const mode = process.env.FAKE_CLAUDE_MODE ?? 'ok';
if (process.env.FAKE_CLAUDE_LOG) fs.appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify(process.argv.slice(2))}\n`);
const report = JSON.parse(fs.readFileSync(process.env.FAKE_CLAUDE_REPORT ?? new URL('../findings/report.json', import.meta.url), 'utf8'));
const base = { type: 'result', subtype: 'success', is_error: false, num_turns: 4, total_cost_usd: 0.0123, session_id: 'fake', result: 'done' };
if (mode === 'error') console.log(JSON.stringify({ ...base, subtype: 'error_max_budget_usd', is_error: true, result: 'budget exceeded' }));
else if (mode === 'nostructure') console.log(JSON.stringify(base));
else if (mode === 'invalid') console.log(JSON.stringify({ ...base, structured_output: { findings: 'none' } }));
else if (mode === 'text') console.log('not json at all');
else if (mode === 'result-only') console.log(JSON.stringify({ ...base, result: JSON.stringify(report) }));
else console.log(JSON.stringify({ ...base, structured_output: report }));
